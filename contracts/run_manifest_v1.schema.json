{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cspm://contracts/run_manifest_v1.schema.json",
  "title": "CSPM Run Manifest v1",
  "description": "Authoritative root run manifest stored at <run>/manifest.json. Trace-specific shape/chunk semantics belong to <run>/trace/manifest.json under TraceArtifact v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "code_sha",
    "config_sha256",
    "dataset_sha256",
    "seed",
    "started_at",
    "completed_at",
    "artifacts",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP[0-9]{3}$"},
    "code_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "seed": {"type": "integer"},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical portable run-relative artifact path: lowercase ASCII segments separated by '/', characters [a-z0-9._-] only, no leading/trailing dot segment form, and no Windows reserved device basename. This excludes absolute/drive/UNC/backslash paths, dot/dot-dot traversal, ADS ':', spaces, trailing dot/space aliases, repeated separators, Unicode/case-fold aliases, and reserved CON/PRN/AUX/NUL/COM1-9/LPT1-9 names (including extensions).",
            "pattern": "^(?!.*(?:^|/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[.][a-z0-9._-]+)?(?:/|$))[a-z0-9_-](?:[a-z0-9._-]*[a-z0-9_-])?(?:/[a-z0-9_-](?:[a-z0-9._-]*[a-z0-9_-])?)*$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "metrics": {"type": "object"}
  }
}
